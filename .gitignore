# pixi environments
.pixi/*
!.pixi/config.toml
# compiled Mojo package output
/build/
*.mojopkg
# in-session build/collection cache and persistent last-run state
.mtest-cache/
# python bytecode
__pycache__/
*.pyc
# ruff and mypy caches, written at the repo root by pixi run py-check
.mypy_cache/
.ruff_cache/
# linked git worktrees for parallel branches; checkouts, not repository content
.worktrees/
# Claude Code session state and its agent worktrees
.claude/
# uv writes an empty lock beside the tool-only pyproject.toml; there is no project to lock
/uv.lock
# internal working plans, notes, and review outputs — never committed or published
docs/plans/
docs/superpowers/
notes/
.superpowers
